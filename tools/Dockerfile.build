# Image used ONLY locally to build the maps (not submitted).
# Same base image and packages as the scorer, plus sqlglot at the pinned commit.
FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90
COPY requirements.lock /tmp/requirements.lock
RUN pip install -q --root-user-action=ignore -r /tmp/requirements.lock
ARG COMMIT=eb11aec4be8cb2122afe713a4816662c3f0fb2fa
RUN python -c "import io,tarfile,urllib.request; \
tarfile.open(fileobj=io.BytesIO(urllib.request.urlopen('https://github.com/tobymao/sqlglot/archive/${COMMIT}.tar.gz').read())).extractall('/opt', filter='data')" \
 && mv /opt/sqlglot-${COMMIT} /opt/sqlglot
# git is only needed by tools/validate.py (`git apply` handles new/deleted files).
RUN apt-get update -q && apt-get install -y -q --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/sqlglot
